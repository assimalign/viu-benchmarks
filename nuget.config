<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
      Repo-local NuGet configuration.

      - viu-local: the sibling Viu feed. It supplies every Assimalign.Viu.* package these
        harnesses measure. This repository holds no framework source, so the feed is the only
        way it sees Viu at all.

        Populate it from a sibling checkout of assimalign/viu:

            pwsh ../viu/scripts/Install-Local.ps1 -SkipSdk -SkipFramework

        CI does exactly the same thing, checking both repositories out as siblings so this
        relative path resolves identically there. That is deliberate: a folder feed that only
        works on a developer's disk is how the sibling viu-examples feed silently rotted.

      - nuget.org: BenchmarkDotNet and the xunit/Shouldly test stack.

      clear ensures user and machine package sources do not silently change the repository build.
  -->
  <packageSources>
    <clear />
    <add key="viu-local" value="..\viu\_out\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Assimalign.Viu.* is never resolved from a public feed: the measured build must be the one
         packed from the paired checkout, not whatever a public feed happens to carry. -->
    <packageSource key="viu-local">
      <package pattern="Assimalign.Viu.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!-- Local Viu repacks reuse the same version, so a machine-wide cache would serve a stale
         extract of a package whose contents changed. The directory is ignored by this repository. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
