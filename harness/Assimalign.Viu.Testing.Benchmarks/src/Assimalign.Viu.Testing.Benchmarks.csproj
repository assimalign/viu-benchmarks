<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Viu performance benchmark suite ([V01.01.11.04], #88). A non-shipping, never-packed console
    app hosting two things on CoreCLR (never a browser, never trimmed/AOT'd — like a test project):

      1. BenchmarkDotNet micro/meso benchmarks of the pure-.NET hot paths the architecture bets on —
         reactivity track/trigger, component render-frame contract/cache setup ([V01.01.06.14], #350),
         renderer diff/patch over the in-memory test adapter, and compiled direct-write server rendering
         against virtual-tree traversal. Wall-clock numbers are environment-relative, so they are
         published as artifacts, never a CI gate.
      2. A deterministic interop-count harness: it drives the js-framework-benchmark scenarios through
         the same in-memory adapter and counts node operations. Op count is the DOM-free proxy for
         JSImport crossings (Assimalign.Viu.Testing's op log == "N node ops == N interop calls"), so it
         is exact and machine-independent — the metric the regression gate compares to a reviewed
         baseline (benchmarks/baselines/InteropCounts.json).

    Viu arrives as packages, not project references: this repository holds no framework source. The
    version is decided centrally in build/Targets/Build.References.Packages.targets and CI's
    paired-checkout lane overrides it with a freshly packed Viu HEAD, so the gate keeps measuring the
    renderer rather than a frozen pin.

    The packaged-consumer Playwright harness ([V01.01.11.03], #87) supplies real-browser
    publish/serve/drive plumbing and remains in the Viu repository. The separate Browser subject
    and scripts/Invoke-BrowserBenchmarks.ps1 measure real WASM elapsed time, command-buffer frames,
    and per-assembly publish payload; this legacy harness remains the deterministic adapter gate.
  -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Benchmark methods and the harness types are public by contract (BenchmarkDotNet requires public
         benchmark classes/methods); this app has no public-API surface to document for consumers. -->
    <RootNamespace>Assimalign.Viu.Testing.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ViuBenchmarkPackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory adapter (its op log is the interop proxy), the runtime core, and the server
         renderer whose compiler-shaped direct-write path the benchmark measures directly. -->
    <ViuBenchmarkPackageReference Include="Assimalign.Viu.ServerRenderer" />
    <ViuBenchmarkPackageReference Include="Assimalign.Viu.Testing" />
    <ViuBenchmarkPackageReference Include="Assimalign.Viu.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reviewed interop-count baseline travels with the app so the gate can find it beside the
         binary in CI, and a local interop run compares against the checked-in numbers. -->
    <Content Include="$(ViuBenchmarksRepositoryDirectory)benchmarks\baselines\InteropCounts.json" Link="baselines\InteropCounts.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
